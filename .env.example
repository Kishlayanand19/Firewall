# =============================================================================
# Thought Firewall — environment template (PLACEHOLDERS ONLY)
# Copy to .env (local) or set in your hosting provider (production).
# NEVER commit real secrets.
# =============================================================================

# --- Frontend (Vercel) — public vars only, safe in browser bundles ---
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api/v1
NEXT_PUBLIC_WS_URL=wss://api.your-domain.com

# Optional auth (Clerk) — publishable key only on frontend
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Clerk secret — backend/server only (NOT NEXT_PUBLIC_)
CLERK_SECRET_KEY=sk_test_replace_me

# --- Backend (Railway / Render) ---
ENVIRONMENT=production
DEBUG=false
ENABLE_DOCS=false

OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini

# Hosted PostgreSQL (Railway/Render/Neon/Supabase)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL_SYNC=postgresql://USER:PASSWORD@HOST:5432/DATABASE

REDIS_URL=redis://default:PASSWORD@HOST:6379/0
USE_REDIS=false

# Comma-separated production frontend origins (HTTPS only)
CORS_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com

RATE_LIMIT=30/minute
ANALYZE_RATE_LIMIT=10/minute
MAX_REQUEST_BODY_BYTES=1048576
MAX_CONTENT_LENGTH=50000
AI_REQUEST_TIMEOUT_SECONDS=120

# --- Local Docker Compose only ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=thoughtfirewall
