# Backend — copy to .env for local development
# Production: set in Railway/Render dashboard (never commit .env)

ENVIRONMENT=development
DEBUG=true
ENABLE_DOCS=true

OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_MODEL_FAST=openai/gpt-4o-mini
OPENAI_MODEL_SYNTHESIS=openai/gpt-4o-mini
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.2
PREFER_HEURISTIC_SYNTHESIS=false
FORCE_LLM_SYNTHESIS=false
ENABLE_ANALYSIS_CACHE=true
CACHE_TTL_SECONDS=3600

DATABASE_URL=sqlite+aiosqlite:///./thoughtfirewall.db
DATABASE_URL_SYNC=sqlite:///./thoughtfirewall.db

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT=30/minute
ANALYZE_RATE_LIMIT=10/minute
MAX_REQUEST_BODY_BYTES=1048576
MAX_CONTENT_LENGTH=50000
AI_REQUEST_TIMEOUT_SECONDS=120

REDIS_URL=redis://localhost:6379/0
USE_REDIS=false
